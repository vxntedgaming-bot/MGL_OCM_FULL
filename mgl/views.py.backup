from django.contrib import messages
from django.contrib.auth.decorators import login_required
from django.db import transaction
from django.shortcuts import get_object_or_404, redirect, render
from django.utils import timezone
from django.views.decorators.http import require_POST
from managers.models import ManagerApplication
from players.models import Player
from .forms import TeamStatsForm
from .models import Fixture, MatchSubmission, TeamMatchStats, GoalEvent, AssistEvent, DefenderRating, GKSave, PressConference, NewsPost
from .services import manager_for_user, credit_manager

@transaction.atomic
def home(request):
    upcoming=Fixture.objects.filter(is_released=True,status="SCHEDULED").select_related("home_team","away_team")[:5]
    news=NewsPost.objects.filter(published=True).order_by("-created_at")[:6]
    return render(request,"core/home.html",{"upcoming":upcoming,"news":news})

@login_required
def manager_hub(request):
    manager=manager_for_user(request.user)
    if not manager: return redirect("manager_login")
    team=getattr(request.user,"managed_team",None)
    recent=Fixture.objects.filter(home_team=team).union(Fixture.objects.filter(away_team=team)).order_by("-id")[:10] if team else []
    return render(request,"mgl/manager_hub.html",{"manager":manager,"team":team,"recent":recent})

@login_required
def fixture_list(request):
    fixtures=Fixture.objects.filter(is_released=True).select_related("home_team","away_team","league")
    return render(request,"mgl/fixtures.html",{"fixtures":fixtures})

@login_required
@transaction.atomic
def submit_match(request, fixture_id):
    fixture=get_object_or_404(Fixture.objects.select_related("home_team","away_team"),pk=fixture_id,is_released=True)
    manager=manager_for_user(request.user)
    if not manager or request.user not in [fixture.home_team.manager,fixture.away_team.manager]:
        messages.error(request,"Only the two managers in this fixture can submit the match."); return redirect("fixture_list")
    if MatchSubmission.objects.filter(fixture=fixture).exists():
        messages.error(request,"This match has already been submitted."); return redirect("fixture_list")
    if request.method=="POST":
        sub=MatchSubmission.objects.create(fixture=fixture,submitted_by=request.user)
        for team in [fixture.home_team,fixture.away_team]:
            prefix="home_" if team==fixture.home_team else "away_"
            goals=int(request.POST.get(prefix+"goals",0)); shots=int(request.POST.get(prefix+"shots",0)); possession=int(request.POST.get(prefix+"possession",50))
            ts=TeamMatchStats.objects.create(submission=sub,team=team,goals=goals,shots=shots,possession=possession)
            for pid in request.POST.getlist(prefix+"goal_players"):
                p=get_object_or_404(Player,pk=pid,mgl_team=team); GoalEvent.objects.create(team_stats=ts,player=p)
            for pid in request.POST.getlist(prefix+"assist_players"):
                p=get_object_or_404(Player,pk=pid,mgl_team=team); AssistEvent.objects.create(team_stats=ts,player=p)
            for p in Player.objects.filter(mgl_team=team).filter(position__in=["CB","LB","RB","LWB","RWB"]):
                val=request.POST.get(f"{prefix}def_{p.id}")
                if val not in (None,""): DefenderRating.objects.create(team_stats=ts,player=p,rating=val)
            for p in Player.objects.filter(mgl_team=team,position="GK"):
                val=request.POST.get(f"{prefix}save_{p.id}")
                if val not in (None,""): GKSave.objects.create(team_stats=ts,player=p,saves=val)
        messages.success(request,"Match submitted to Admin for approval."); return redirect("fixture_list")
    teams=[]
    for team in [fixture.home_team,fixture.away_team]: teams.append((team,list(Player.objects.filter(mgl_team=team))))
    return render(request,"mgl/submit_match.html",{"fixture":fixture,"teams":teams})

@login_required
@require_POST
def press_conference(request,fixture_id):
    fixture=get_object_or_404(Fixture,pk=fixture_id)
    manager=manager_for_user(request.user)
    if not manager or request.user not in [fixture.home_team.manager,fixture.away_team.manager]: return redirect("fixture_list")
    answer=request.POST.get("answer","").strip()
    if not answer: messages.error(request,"Please answer the question."); return redirect("fixture_list")
    obj,_=PressConference.objects.update_or_create(fixture=fixture,manager=request.user,defaults={"question":request.POST.get("question",""),"answer":answer,"status":"PENDING"})
    # Press reward is awarded only after admin approval.
    messages.success(request,"Press conference submitted for approval."); return redirect("fixture_list")


@login_required
def team_management(request):
    team=getattr(request.user,"managed_team",None)
    if not team: return render(request,"mgl/team_management.html",{"team":None})
    return render(request,"mgl/team_management.html",{"team":team,"players":team.players.all().order_by("position","-overall","name")})

@login_required
@require_POST
def release_my_player(request, player_id):
    from .services import release_player
    team=getattr(request.user,"managed_team",None)
    player=get_object_or_404(Player,pk=player_id,mgl_team=team)
    release_player(player,team,source="MANAGER_RELEASE")
    messages.success(request,f"{player.name} released to Free Agents.")
    return redirect("team_management")

@login_required
def free_agents(request):
    players=Player.objects.filter(is_free_agent=True,mgl_team__isnull=True).order_by("-overall","name")
    return render(request,"mgl/free_agents.html",{"players":players})

@login_required
def manager_profile(request):
    manager=manager_for_user(request.user)
    career=getattr(manager,"career",None) if manager else None
    trophies=manager.trophies.all() if manager else []
    return render(request,"mgl/profile.html",{"manager":manager,"career":career,"trophies":trophies})

@login_required
def player_database(request):
    players=Player.objects.all().order_by("-overall","name")
    return render(request,"mgl/player_database.html",{"players":players})
