# Copy to .env for local overrides. Do not commit real secrets.

# Required in production (DJANGO_DEBUG=false). Local development can omit this.
# DJANGO_SECRET_KEY=replace-with-a-long-random-value

# Local default is true. Set false on a real host.
DJANGO_DEBUG=true

# Comma-separated. Required when DJANGO_DEBUG=false.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Include the scheme. Example for production: https://ocm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional. Defaults to SQLite at db.sqlite3.
# DATABASE_URL=postgres://mgl:mgl@127.0.0.1:5432/mgl
# POSTGRES_DB=mgl
# POSTGRES_USER=mgl
# POSTGRES_PASSWORD=mgl
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Optional paths. Defaults keep existing project layout.
# DJANGO_STATIC_ROOT=/var/www/mgl/staticfiles
# DJANGO_MEDIA_ROOT=/var/www/mgl/media

# Serve uploaded team logos from Django when there is no nginx/media server.
# DJANGO_SERVE_MEDIA=true

# Production email (ignored while DJANGO_DEBUG=true; console backend is used).
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=MGL <noreply@example.com>

# Gunicorn
# GUNICORN_BIND=0.0.0.0:8000
# If GUNICORN_BIND is unset, Railway's PORT is used.
# GUNICORN_WORKERS=2

# Discord bot (separate process). Official events are queued first.
# DISCORD_TOKEN=
# UFL_CHANNELS=NEWS:123,TRANSFERS:456,AUCTIONS:789,RECRUITMENT:111,SCOUTING:222,RESULTS:333,REWARDS:444,JOBS:555,ANNOUNCEMENTS:666
# Optional extras still accepted: PRESS, FREE_AGENTS, TRANSFER MARKET.
# Missing keys fall back to NEWS. None of these channels are required yet.
# Legacy aliases TRANSFER and MGL_CHANNELS still resolve if present.

# Public Discord invite used by JOIN DISCORD buttons. Leave empty to hide them.
# DISCORD_INVITE_URL=https://discord.gg/your-invite
